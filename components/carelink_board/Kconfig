menu "CareLink board"
    choice CARELINK_BOARD
        prompt "Heltec WiFi LoRa 32 V4 variant"
        default CARELINK_BOARD_HELTEC_V4_R2
        config CARELINK_BOARD_HELTEC_V4_R2
            bool "V4 ESP32-S3R2 (2 MB PSRAM)"
        config CARELINK_BOARD_HELTEC_V4_R8
            bool "V4 ESP32-S3R8 (8 MB PSRAM)"
    endchoice

    config CARELINK_GNSS_SOCKET_POWER
        bool "Enable power on the Heltec GNSS socket"
        default y
        help
            Active low: GPIO34 on R2, GPIO42 on R8. Disable for a
            separately powered breakout connected with jumper wires.

    config CARELINK_GPS_RX_GPIO
        int "ESP32 UART RX GPIO (connect to GNSS TX)"
        range 0 48
        default 39
        help
            The socket TX_GPS net is GPIO39, named from the GNSS perspective.
            Jumper wiring may use another free pin; reserved pins are rejected.

    config CARELINK_GPS_BAUD
        int "GNSS UART baud rate"
        range 1200 115200
        default 9600
endmenu
