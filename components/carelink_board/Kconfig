menu "CareLink board"
    choice CARELINK_BOARD
        prompt "Heltec WiFi LoRa 32 V4 variant"
        default CARELINK_BOARD_HELTEC_V4_R2
        config CARELINK_BOARD_HELTEC_V4_R2
            bool "V4 ESP32-S3R2 (2 MB PSRAM)"
        config CARELINK_BOARD_HELTEC_V4_R8
            bool "V4 ESP32-S3R8 (8 MB PSRAM)"
    endchoice

    config CARELINK_GNSS_SOCKET_POWER
        bool "Enable power on the Heltec GNSS socket"
        default y
        help
            Active low: GPIO34 on R2, GPIO42 on R8. Disable for a
            separately powered breakout connected with jumper wires.

    config CARELINK_GPS_RX_GPIO
        int "ESP32 UART RX GPIO (connect to GNSS TX)"
        range 0 48
        default 39
        help
            The socket TX_GPS net is GPIO39, named from the GNSS perspective.
            Jumper wiring may use another free pin; reserved pins are rejected.

    config CARELINK_GPS_BAUD
        int "GNSS UART baud rate"
        range 1200 115200
        default 9600
    if CARELINK_IMU_ENABLED
        config CARELINK_IMU_SHARED_I2C
            bool "IMU shares OLED I2C0 (SDA17/SCL18)"
            default n
            help
                Enable only if the IMU is physically wired to the OLED bus.
                Otherwise the IMU uses I2C1 on the header pins below.

        config CARELINK_IMU_SDA_GPIO
            int "IMU SDA GPIO (-1 means not configured)"
            depends on !CARELINK_IMU_SHARED_I2C
            range -1 48
            default -1

        config CARELINK_IMU_SCL_GPIO
            int "IMU SCL GPIO (-1 means not configured)"
            depends on !CARELINK_IMU_SHARED_I2C
            range -1 48
            default -1

        config CARELINK_IMU_VEXT_POWER
            bool "IMU powered from Vext"
            default y
            help
                Enable Vext before initializing the IMU. Vext stays enabled
                because OLED and other external devices may share this supply.
    endif
endmenu
