CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_CARELINK_BUZZER_ENABLED=y
CONFIG_CARELINK_BUTTON_ENABLED=y
CONFIG_CARELINK_BUTTON_GPIO=4
CONFIG_CARELINK_IMU_ENABLED=y
CONFIG_CARELINK_IMU_SDA_GPIO=47
CONFIG_CARELINK_IMU_SCL_GPIO=48
